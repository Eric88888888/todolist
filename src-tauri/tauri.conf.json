{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Todolist",
  "version": "1.0.0",
  "identifier": "com.dsh.todolist",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "待办清单",
        "width": 780,
        "height": 700,
        "minWidth": 520,
        "minHeight": 460,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Cheng",
    "copyright": "© 2026 Cheng",
    "category": "Productivity",
    "shortDescription": "本地待办清单",
    "longDescription": "纯本地运行的待办清单：任务、子任务、备注、循环任务、多种底色、置顶与拖拽排序。数据只存在本机 SQLite 文件里，不联网。支持托盘常驻、到期系统通知与全局快捷键 Ctrl+Shift+Space 快速记一笔。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
